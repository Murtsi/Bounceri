# PRIVATE Docker-only gateway. Never attach a published port or Traefik label.
# Only the bundled simulator can supply synthetic forwarded IPs and signed labels.
{
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}
:8080 {
	@health path /healthz
	log_skip @health
	log {
		output file /var/log/caddy/access.log {
			roll_size 5MiB
			roll_keep 2
			roll_keep_for 24h
		}
		format json
	}
	reverse_proxy site:8000
}
