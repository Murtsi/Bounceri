# Copy to .env and fill in. .env is git-ignored; this file is committed.
# Never commit real credentials.

# --- app ---
APP_NAME=Junction
APP_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# --- database (matches docker-compose.yml) ---
POSTGRES_USER=junction
POSTGRES_PASSWORD=junction
POSTGRES_DB=junction
POSTGRES_PORT=5432
DATABASE_URL=postgres://junction:junction@localhost:5432/junction

# --- cache (uncomment the redis service in docker-compose.yml first) ---
# REDIS_URL=redis://localhost:6379

# --- third-party APIs: add only what you actually use, and rotate before submission ---
# OPENAI_API_KEY=
# GITHUB_TOKEN=
