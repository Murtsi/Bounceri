# Copy to .env and fill in. .env is git-ignored; this file is committed.
# Never commit real credentials.

# --- app ---
APP_NAME=Bounceri
APP_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# --- local development database (matches docker-compose.yml) ---
# These public example credentials are for local development only.
# Set a unique password before deploying and update DATABASE_URL to match.
POSTGRES_USER=junction
POSTGRES_PASSWORD=junction
POSTGRES_DB=junction
POSTGRES_PORT=5432
DATABASE_URL=postgres://junction:junction@localhost:5432/junction
# Local S3 JSON store (used when Postgres loaders are not wired yet):
# BOUNCER_STORE_PATH=.bouncer_store.json

# --- cache (uncomment the redis service in docker-compose.yml first) ---
# REDIS_URL=redis://localhost:6379

# --- third-party APIs: add only what you actually use, and rotate before submission ---
# OPENAI_API_KEY=
# GITHUB_TOKEN=

# --- Featherless reviewer / explanation provider ---
# Choose an exact model ID available on your plan; no implicit model is selected.
LLM_PROVIDER=featherless
# FEATHERLESS_API_KEY=
# LLM_MODEL=

# --- Hostinger AI Router (Decision-1 stage; explicit legacy explanation opt-in) ---
# The Decision-1 integration and its exact model/endpoint are still pending.
# For legacy explanation calls set LLM_PROVIDER=hostinger and an explicit LLM_MODEL.
# HOSTINGER_AI_API_KEY=
# HOSTINGER_AI_BASE_URL=https://router.hostinger.com/v1
# OPENAI_API_KEY=   # optional alias; explain() accepts either key name
# Also accepts HOSTINGER_ROUTER_API_KEY (LiteLLM / hPanel naming)

# --- simulator ground truth (kaista A, päätös 046) ---
# Pakollinen tuotannossa: ilman tätä X-Sim-Run-labeleita ei tarkisteta.
# Simulaattorit allekirjoittavat merkinnän: X-Sim-Sig = HMAC-SHA256(SIM_RUN_SECRET, X-Sim-Run).
# SIM_RUN_SECRET=

# --- Persistent investigations / private operations ---
# PostgreSQL 16 in production; SQLite may be used for offline development.
# BOUNCER_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@db/bouncer
# BOUNCER_ADMIN_TOKEN=          # generate at least 32 random bytes; never put in frontend
# BOUNCER_DEMO_ACTOR_SECRET=    # at least 32 characters; private actor provisioning only

# --- Bounded two-role review (owner-selected Featherless; off until verified) ---
BOUNCERI_REVIEW_ENABLED=false
BOUNCERI_DECISION_PROVIDER=featherless
BOUNCERI_AUTO_REVIEW=false
BOUNCERI_AUTO_REVIEW_MAX_EXECUTIONS=20
# Both roles use FEATHERLESS_API_KEY. Select explicit models after account discovery.
BOUNCERI_DECISION_ENABLED=false
BOUNCERI_DECISION_MODEL=
BOUNCERI_DECISION_EXPECTED_MODEL=
BOUNCERI_DECISION_ENDPOINT=https://api.featherless.ai/v1/chat/completions
BOUNCERI_DECISION_CONTRACT_VERIFIED=false
BOUNCERI_DECISION_IDENTITY_VERIFIED=false
BOUNCERI_DECISION_NO_FALLBACK_VERIFIED=false
BOUNCERI_DECISION_PRICING_VERIFIED=false
BOUNCERI_DECISION_LIMITS_VERIFIED=false
BOUNCERI_DECISION_MAXIMUM_COST_MICROUSD=0
BOUNCERI_DECISION_PRICING_VERSION=
BOUNCERI_REVIEWER_ENABLED=false
BOUNCERI_REVIEWER_MODEL=
BOUNCERI_REVIEWER_EXPECTED_MODEL=
BOUNCERI_REVIEWER_ENDPOINT=https://api.featherless.ai/v1/chat/completions
BOUNCERI_REVIEWER_CONTRACT_VERIFIED=false
BOUNCERI_REVIEWER_IDENTITY_VERIFIED=false
BOUNCERI_REVIEWER_NO_FALLBACK_VERIFIED=false
BOUNCERI_REVIEWER_PRICING_VERIFIED=false
BOUNCERI_REVIEWER_LIMITS_VERIFIED=false
BOUNCERI_REVIEWER_MAXIMUM_COST_MICROUSD=0
BOUNCERI_REVIEWER_PRICING_VERSION=
# Private variable simulator: continuously compose fresh replayable episodes.
# It can reach only simulation-gateway:8080; that container has no public port or route.
SIMULATION_MODE=dynamic
SIMULATION_MAX_ROUNDS=0
SIMULATION_MAX_ACTORS=24
SIMULATION_MAX_REQUESTS=240
SIMULATION_MAX_DURATION_SECONDS=120
SIMULATION_REQUESTS_PER_SECOND=4
SIMULATION_STATE_DIR=/simulation
# Explicit legacy/debug mode alone uses SIMULATION_HUMANS and SIMULATION_INTERVAL_SECONDS.
